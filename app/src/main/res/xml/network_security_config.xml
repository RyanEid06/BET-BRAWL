<?xml version="1.0" encoding="utf-8"?>
<!--
  BET & BRAWL: Network Security Configuration
  Permits cleartext ws:// traffic strictly for local peer-to-peer Wi-Fi LAN brawling
  while ensuring system CA certificates are maintained.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

{
  "name": "bet-brawl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "host": "npm run build && tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/engine/odds.test.ts src/engine/roomEngine.test.ts src/engine/gameEngine.test.ts src/engine/networkDiscovery.test.ts src/engine/multiplayer.test.ts",
    "verify": "npm run typecheck && npm test && npm run test:worker-core && npm run build && npm run cf:typecheck",
    "cf:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "cf:dev": "npm run build && wrangler dev --local",
    "test:cloudflare": "npm run build && tsx scripts/cloudflare-multiplayer.test.ts",
    "test:worker-core": "tsx --test worker/BrawlRoom.test.ts",
    "cf:verify": "npm run verify && npm run cf:dry-run && npm run test:cloudflare",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "wrangler": "4.151.1"
  }
}

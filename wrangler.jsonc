{
  "name": "bet-brawl",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRAWL_ROOMS",
        "class_name": "BrawlRoom"
      }
    ]
  },
  "exports": {
    "BrawlRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
